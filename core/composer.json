{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2|^8.1|^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "anhskohbo/no-captcha": "^3.1",
        "barryvdh/laravel-dompdf": "^2.0",
        "cartalyst/stripe-laravel": "15.*",
        "doctrine/dbal": "^3.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel-lang/lang": "~12.0",
        "laravel-notification-channels/webpush": "^7.0",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.3",
        "mollie/laravel-mollie": "^2.22",
        "phpmailer/phpmailer": "^6.6",
        "rachidlaasri/laravel-installer": "^4.1",
        "razorpay/razorpay": "2.*",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-cookie-consent": "^3.2",
        "spatie/laravel-sitemap": "^6.3",
        "unisharp/laravel-filemanager": "^2.6",
        "willvincent/feeds": "^2.1"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/Http/Helpers/Helper.php", "app/Http/Helpers/Sections.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
