# Ignore all common image formats in assets/
/assets/**/*.jpg
/assets/**/*.jpeg
/assets/**/*.png
/assets/**/*.gif
/assets/**/*.svg
/assets/**/*.ico
/assets/**/*.webp

# Ignore font files in assets/ and installer/
/assets/**/*.svg
/installer/**/*.svg

# Ignore specific image directories
/assets/lfm/files/
/assets/front/receipt/
/assets/admin/img/
/assets/user/img/
/installer/img/

# Ignore vendor directory
/core/vendor/

# Ignore node modules
/core/node_modules/

# Ignore core/public (auto-generated)
/core/public/

# Ignore Laravel storage and cache
/core/storage/*.key
/core/storage/logs/*.log
/core/bootstrap/cache/*.php
!/.gitkeep

# Ignore environment file
/core/.env
/core/.env.backup

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db
