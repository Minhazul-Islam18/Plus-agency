# Ignore uploaded images
/assets/front/img/*.jpg
/assets/front/img/*.jpeg
/assets/front/img/*.png
/assets/front/img/*.gif
/assets/front/img/*.webp

# Ignore file manager uploads
/assets/lfm/files/

# Ignore page breadcrumb images
/assets/front/img/pages/

# Ignore vendor directory
/core/vendor/

# Ignore node modules
/core/node_modules/

# Ignore core/public (auto-generated)
/core/public/

# Ignore Laravel storage and cache
/core/storage/*.key
/core/storage/logs/*.log
/core/bootstrap/cache/*.php
!/.gitkeep

# Ignore environment file
/core/.env
/core/.env.backup

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db
