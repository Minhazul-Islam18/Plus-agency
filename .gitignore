# Ignore all common image formats in assets/
/assets/**/*.jpg
/assets/**/*.jpeg
/assets/**/*.png
/assets/**/*.gif
/assets/**/*.svg
/assets/**/*.ico
/assets/**/*.webp

# Ignore font files in assets/ and installer/
/assets/**/*.svg
/installer/**/*.svg

# Ignore specific image directories
/assets/lfm/files/
/assets/front/receipt/
/assets/front/tender_proofs/
/assets/front/files/tender_modules/
/assets/front/invoices/tender/
/assets/admin/img/
/assets/user/img/
/installer/img/

# Ignore vendor directory
/core/vendor/

# Ignore node modules
/core/node_modules/

# Ignore core/public (auto-generated)
/core/public/

# Ignore Laravel storage and cache
/core/storage/*.key
/core/storage/logs/*.log
/core/bootstrap/cache/*.php
!/.gitkeep

# Ignore environment file
/core/.env
/core/.env.backup
/core/.env.testing

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo
*~
# Merge/checkout backup artifacts (e.g. file.jpg~<sha>, file.jpg~HEAD) —
# *~ above only matches a trailing tilde, not these suffixed ones.
*~*

# Ignore OS files
.DS_Store
Thumbs.db

# Debugbar (dev-only, published config + runtime cache — not custom config)
/core/config/debugbar.php
/core/storage/debugbar/

# HTMLPurifier generated cache (version-hash filenames, never hand-authored)
/core/storage/app/purifier/

# SetaPDF Stamper (licensed, not redistributable)
core/setapdf/
setapdf-live.zip

# Composer credentials for the SetaPDF private repository — never commit
core/auth.json

# SonarScanner working directory
/.scannerwork/

# PHPUnit coverage report (generated)
/core/coverage.xml
